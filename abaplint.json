{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [],
  "syntax": {
    "version": "v702",
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "parser_error": true,
    "check_syntax": true,
    "unknown_types": true,
    "obsolete_statement": true,
    "line_length": { "length": 255 },
    "unused_variables": true,
    "unused_types": true,
    "keyword_case": false,
    "exporting": true,
    "functional_writing": false
  }
}
